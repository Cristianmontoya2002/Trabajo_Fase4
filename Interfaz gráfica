PARTE 3 DE 3 — INTERFAZ GRÁFICA CON TKINTER
Este módulo presenta las operaciones de SistemaFJ mediante ventanas y formularios.
La lógica de negocio permanece en modelos.py y gestion.py.
"""

import tkinter as tk  # Biblioteca estándar para crear interfaces gráficas.
from tkinter import ttk, messagebox, simpledialog  # Controles y cuadros de diálogo de Tkinter.
from contextlib import redirect_stdout  # Permite capturar la salida de la demostración.
from io import StringIO  # Almacena temporalmente el texto de la demostración.

from modelos import (  # Importa los tipos de servicio, estados y errores.
    ReservaSala, AlquilerEquipo, Asesoria, ErrorSistema, EstadoReserva
)
from gestion import SistemaFJ, ejecutar_demo  # Importa la administración y demostración.


# Ventana principal de la aplicación.
class AplicacionFJ:
    def __init__(self, ventana: tk.Tk):
        self.ventana = ventana  # Guarda la ventana principal.
        self.ventana.title("SOFTWARE FJ | Gestión de clientes, servicios y reservas")
        self.ventana.geometry("1050x650")  # Define el tamaño inicial de la ventana.
        self.ventana.minsize(850, 550)  # Evita que la ventana sea demasiado pequeña.
        self.sistema = SistemaFJ()  # Crea la instancia que conserva los datos en memoria.
        self._crear_interfaz()  # Construye los controles visuales.

    # Construye el encabezado, las pestañas y el área de resultados.
    def _crear_interfaz(self):
        encabezado = ttk.Label(
            self.ventana,
            text="SOFTWARE FJ\nGestión de clientes, servicios y reservas",
            font=("Arial", 17, "bold"),
            anchor="center"
        )
        encabezado.pack(fill="x", padx=10, pady=12)

        self.pestanas = ttk.Notebook(self.ventana)
        self.pestanas.pack(fill="both", expand=True, padx=10, pady=5)

        self.tab_clientes = ttk.Frame(self.pestanas)
        self.tab_servicios = ttk.Frame(self.pestanas)
        self.tab_reservas = ttk.Frame(self.pestanas)
        self.tab_consultas = ttk.Frame(self.pestanas)

        self.pestanas.add(self.tab_clientes, text="Clientes")
        self.pestanas.add(self.tab_servicios, text="Servicios")
        self.pestanas.add(self.tab_reservas, text="Reservas")
        self.pestanas.add(self.tab_consultas, text="Consultas y demostración")

        self._crear_tab_clientes()
        self._crear_tab_servicios()
        self._crear_tab_reservas()
        self._crear_tab_consultas()

        self.estado = ttk.Label(self.ventana, text="Sistema listo.", relief="sunken", anchor="w")
        self.estado.pack(fill="x", side="bottom")

    # Presenta los campos y acciones para registrar clientes.
    def _crear_tab_clientes(self):
        marco = ttk.LabelFrame(self.tab_clientes, text="Registrar cliente")
        marco.pack(fill="x", padx=15, pady=15)

        self.nombre_cliente = tk.StringVar()
        self.correo_cliente = tk.StringVar()
        self.telefono_cliente = tk.StringVar()

        self._campo(marco, "Nombre completo:", self.nombre_cliente, 0)
        self._campo(marco, "Correo electrónico:", self.correo_cliente, 1)
        self._campo(marco, "Teléfono:", self.telefono_cliente, 2)

        ttk.Button(marco, text="Registrar cliente", command=self.registrar_cliente).grid(
            row=3, column=1, padx=5, pady=10, sticky="w"
        )
        ttk.Button(marco, text="Actualizar lista", command=self.mostrar_clientes).grid(
            row=3, column=2, padx=5, pady=10
        )

        self.lista_clientes = tk.Listbox(self.tab_clientes, height=12)
        self.lista_clientes.pack(fill="both", expand=True, padx=15, pady=5)
        self.mostrar_clientes()

    # Presenta los campos para crear cualquiera de los tres tipos de servicio.
    def _crear_tab_servicios(self):
        marco = ttk.LabelFrame(self.tab_servicios, text="Crear servicio")
        marco.pack(fill="x", padx=15, pady=15)

        self.tipo_servicio = tk.StringVar(value="Sala")
        self.nombre_servicio = tk.StringVar()
        self.tarifa_servicio = tk.StringVar()
        self.dato_servicio = tk.StringVar()

        ttk.Label(marco, text="Tipo de servicio:").grid(row=0, column=0, padx=5, pady=5, sticky="e")
        selector = ttk.Combobox(
            marco, textvariable=self.tipo_servicio,
            values=("Sala", "Alquiler de equipo", "Asesoría"), state="readonly"
        )
        selector.grid(row=0, column=1, padx=5, pady=5, sticky="ew")
        selector.bind("<<ComboboxSelected>>", self._actualizar_etiqueta_dato)

        self._campo(marco, "Nombre:", self.nombre_servicio, 1)
        self._campo(marco, "Tarifa (COP):", self.tarifa_servicio, 2)

        self.etiqueta_dato = ttk.Label(marco, text="Capacidad de la sala:")
        self.etiqueta_dato.grid(row=3, column=0, padx=5, pady=5, sticky="e")
        ttk.Entry(marco, textvariable=self.dato_servicio).grid(
            row=3, column=1, padx=5, pady=5, sticky="ew"
        )

        ttk.Button(marco, text="Crear servicio", command=self.crear_servicio).grid(
            row=4, column=1, padx=5, pady=10, sticky="w"
        )
        ttk.Button(marco, text="Actualizar lista", command=self.mostrar_servicios).grid(
            row=4, column=2, padx=5, pady=10
        )
        marco.columnconfigure(1, weight=1)

        self.lista_servicios = tk.Listbox(self.tab_servicios, height=12)
        self.lista_servicios.pack(fill="both", expand=True, padx=15, pady=5)
        self.mostrar_servicios()

    # Presenta los controles para crear y gestionar reservas.
    def _crear_tab_reservas(self):
        marco = ttk.LabelFrame(self.tab_reservas, text="Crear reserva")
        marco.pack(fill="x", padx=15, pady=15)

        self.id_cliente_reserva = tk.StringVar()
        self.id_servicio_reserva = tk.StringVar()
        self.duracion_reserva = tk.StringVar()

        self._campo(marco, "ID del cliente:", self.id_cliente_reserva, 0)
        self._campo(marco, "ID del servicio:", self.id_servicio_reserva, 1)
        self._campo(marco, "Duración (horas o días):", self.duracion_reserva, 2)

        ttk.Button(marco, text="Crear reserva", command=self.crear_reserva).grid(
            row=3, column=1, padx=5, pady=10, sticky="w"
        )
        ttk.Button(marco, text="Ver clientes y servicios", command=self.mostrar_referencias).grid(
            row=3, column=2, padx=5, pady=10
        )

        acciones = ttk.LabelFrame(self.tab_reservas, text="Gestionar reserva seleccionada")
        acciones.pack(fill="x", padx=15, pady=8)
        ttk.Button(acciones, text="Confirmar", command=self.confirmar_reserva).pack(side="left", padx=5, pady=8)
        ttk.Button(acciones, text="Procesar", command=self.procesar_reserva).pack(side="left", padx=5, pady=8)
        ttk.Button(acciones, text="Cancelar", command=self.cancelar_reserva).pack(side="left", padx=5, pady=8)
        ttk.Button(acciones, text="Actualizar", command=self.mostrar_reservas).pack(side="left", padx=5, pady=8)

        self.lista_reservas = tk.Listbox(self.tab_reservas, height=12)
        self.lista_reservas.pack(fill="both", expand=True, padx=15, pady=5)
        self.mostrar_reservas()

    # Presenta las consultas generales y la demostración académica.
    def _crear_tab_consultas(self):
        marco = ttk.Frame(self.tab_consultas)
        marco.pack(fill="x", padx=15, pady=12)
        ttk.Button(marco, text="Ver todos los registros", command=self.mostrar_todos).pack(side="left", padx=5)
        ttk.Button(marco, text="Ejecutar demostración académica", command=self.demostracion).pack(side="left", padx=5)

        self.salida = tk.Text(self.tab_consultas, height=22, wrap="word")
        self.salida.pack(fill="both", expand=True, padx=15, pady=5)
        self.salida.insert("end", "En esta sección se muestran las consultas y la salida de la demostración.\\n")
        self.salida.configure(state="disabled")

    # Crea una etiqueta y una caja de texto asociadas a una variable.
    def _campo(self, contenedor, etiqueta, variable, fila):
        ttk.Label(contenedor, text=etiqueta).grid(row=fila, column=0, padx=5, pady=5, sticky="e")
        ttk.Entry(contenedor, textvariable=variable, width=38).grid(
            row=fila, column=1, padx=5, pady=5, sticky="ew"
        )
        contenedor.columnconfigure(1, weight=1)

    # Cambia la etiqueta del dato adicional según el tipo de servicio elegido.
    def _actualizar_etiqueta_dato(self, _evento=None):
        etiquetas = {
            "Sala": "Capacidad de la sala:",
            "Alquiler de equipo": "Unidades disponibles:",
            "Asesoría": "Especialidad:"
        }
        self.etiqueta_dato.configure(text=etiquetas[self.tipo_servicio.get()])

    # Muestra los errores controlados y los errores inesperados en una ventana.
    def _ejecutar_seguro(self, accion):
        try:
            resultado = accion()
            self.estado.configure(text="Operación realizada correctamente.")
            return resultado
        except ErrorSistema as exc:
            self.estado.configure(text="La operación no pudo completarse.")
            messagebox.showerror("Error del sistema", str(exc))
        except (ValueError, TypeError) as exc:
            self.estado.configure(text="Revise los datos ingresados.")
            messagebox.showerror("Dato inválido", str(exc))
        except Exception as exc:
            self.estado.configure(text="Se presentó un error inesperado.")
            messagebox.showerror("Error inesperado", str(exc))
        return None

    # Registra un cliente con los datos escritos en el formulario.
    def registrar_cliente(self):
        def accion():
            cliente = self.sistema.registrar_cliente(
                self.nombre_cliente.get(), self.correo_cliente.get(), self.telefono_cliente.get()
            )
            self.nombre_cliente.set("")
            self.correo_cliente.set("")
            self.telefono_cliente.set("")
            self.mostrar_clientes()
            messagebox.showinfo("Cliente registrado", cliente.describir())
        self._ejecutar_seguro(accion)

    # Actualiza el contenido de la lista de clientes.
    def mostrar_clientes(self):
        self.lista_clientes.delete(0, "end")
        for cliente in self.sistema.clientes:
            self.lista_clientes.insert("end", f"{cliente.id} | {cliente.describir()} | Teléfono: {cliente.telefono}")

    # Crea el objeto correspondiente al tipo de servicio seleccionado.
    def crear_servicio(self):
        def accion():
            tipo = self.tipo_servicio.get()
            nombre = self.nombre_servicio.get()
            tarifa = self.tarifa_servicio.get()
            dato = self.dato_servicio.get()

            if tipo == "Sala":
                servicio = ReservaSala(nombre, tarifa, int(dato))
            elif tipo == "Alquiler de equipo":
                servicio = AlquilerEquipo(nombre, tarifa, int(dato))
            else:
                servicio = Asesoria(nombre, tarifa, dato)

            self.sistema.agregar_servicio(servicio)
            self.nombre_servicio.set("")
            self.tarifa_servicio.set("")
            self.dato_servicio.set("")
            self.mostrar_servicios()
            messagebox.showinfo("Servicio creado", servicio.describir())
        self._ejecutar_seguro(accion)

    # Actualiza la lista de servicios.
    def mostrar_servicios(self):
        self.lista_servicios.delete(0, "end")
        for servicio in self.sistema.servicios:
            self.lista_servicios.insert("end", f"{servicio.id} | {servicio.describir()}")

    # Muestra los identificadores necesarios para crear una reserva.
    def mostrar_referencias(self):
        lineas = ["CLIENTES"]
        lineas.extend(f"{c.id} | {c.describir()}" for c in self.sistema.clientes)
        lineas.append("\\nSERVICIOS")
        lineas.extend(f"{s.id} | {s.describir()}" for s in self.sistema.servicios)
        messagebox.showinfo("Clientes y servicios", "\\n".join(lineas) if lineas else "No hay registros.")

    # Crea una reserva usando los identificadores introducidos.
    def crear_reserva(self):
        def accion():
            reserva = self.sistema.crear_reserva(
                self.id_cliente_reserva.get().strip().upper(),
                self.id_servicio_reserva.get().strip().upper(),
                self.duracion_reserva.get().strip()
            )
            self.duracion_reserva.set("")
            self.mostrar_reservas()
            messagebox.showinfo("Reserva creada", reserva.describir())
        self._ejecutar_seguro(accion)

    # Actualiza la lista de reservas.
    def mostrar_reservas(self):
        self.lista_reservas.delete(0, "end")
        for reserva in self.sistema.reservas:
            self.lista_reservas.insert("end", f"{reserva.id} | {reserva.describir()}")

    # Devuelve la reserva seleccionada en la lista.
    def _reserva_seleccionada(self):
        seleccion = self.lista_reservas.curselection()
        if not seleccion:
            raise ErrorSistema("Seleccione una reserva de la lista.")
        return self.sistema.reservas[seleccion[0]]

    # Confirma la reserva seleccionada.
    def confirmar_reserva(self):
        def accion():
            reserva = self._reserva_seleccionada()
            reserva.confirmar()
            self.mostrar_reservas()
            messagebox.showinfo("Reserva", "Reserva confirmada.")
        self._ejecutar_seguro(accion)

    # Solicita impuesto y descuento y procesa la reserva seleccionada.
    def procesar_reserva(self):
        def accion():
            reserva = self._reserva_seleccionada()
            impuesto = simpledialog.askstring("Impuesto", "Impuesto (ejemplo 0.19; Enter para 0):", parent=self.ventana)
            if impuesto is None:
                return
            descuento = simpledialog.askstring("Descuento", "Descuento (ejemplo 0.10; Enter para 0):", parent=self.ventana)
            if descuento is None:
                return
            total = reserva.procesar(impuesto=impuesto.strip() or "0", descuento=descuento.strip() or "0")
            self.mostrar_reservas()
            messagebox.showinfo("Reserva procesada", f"Total: {total:,.2f} COP")
        self._ejecutar_seguro(accion)

    # Cancela la reserva seleccionada.
    def cancelar_reserva(self):
        def accion():
            reserva = self._reserva_seleccionada()
            reserva.cancelar()
            self.mostrar_reservas()
            messagebox.showinfo("Reserva", "Reserva cancelada.")
        self._ejecutar_seguro(accion)

    # Muestra en el área de texto los registros actuales.
    def mostrar_todos(self):
        lineas = ["CLIENTES"]
        lineas.extend(c.describir() for c in self.sistema.clientes)
        lineas.append("\\nSERVICIOS")
        lineas.extend(s.describir() for s in self.sistema.servicios)
        lineas.append("\\nRESERVAS")
        lineas.extend(r.describir() for r in self.sistema.reservas)
        self._escribir_salida("\\n".join(lineas))

    # Ejecuta la demostración original y captura sus impresiones en la interfaz.
    def demostracion(self):
        contenido = StringIO()
        with redirect_stdout(contenido):
            ejecutar_demo()
        self._escribir_salida(contenido.getvalue())
        messagebox.showinfo("Demostración", "La demostración académica terminó. Consulte el resultado en esta pestaña.")

    # Escribe texto en el control de salida y permite volver a consultarlo.
    def _escribir_salida(self, texto):
        self.salida.configure(state="normal")
        self.salida.delete("1.0", "end")
        self.salida.insert("end", texto)
        self.salida.configure(state="disabled")


# Inicia la aplicación gráfica cuando este archivo se ejecuta directamente.
def ejecutar_aplicacion():
    ventana = tk.Tk()
    AplicacionFJ(ventana)
    ventana.mainloop()


# Evita iniciar la ventana cuando este módulo se importa desde otro archivo.
if __name__ == "__main__":
    ejecutar_aplicacion()
